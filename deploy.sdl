version: "2.0"

services:
  aeon-relay:
    image: crushiodarhk/aeon-aegis:latest
    expose:
      - port: 9090
        as: 9090
        proto: tcp
        to:
          - global: true
      - port: 9091
        as: 9091
        proto: tcp
        to:
          - global: true
    env:
      - "NODE_ENV=production"
      - "RELAY_P2P_PORT=9090"
      - "RELAY_CONTROL_PORT=9091"
      - "ORIGIN_HOST=127.0.0.1"
      - "ORIGIN_PORT=8080"

profiles:
  compute:
    aeon-relay:
      resources:
        cpu:
          units: 0.5
        memory:
          size: 512Mi
        storage:
          size: 2Gi
  placement:
    akash:
      pricing:
        aeon-relay:
          denom: uakt
          amount: 10000

deployment:
  aeon-relay:
    akash:
      profile: aeon-relay
      count: 1
